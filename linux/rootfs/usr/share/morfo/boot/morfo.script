// Morfo Linux — animação de boot (Plymouth, módulo "script").
// O mesmo script serve aos dois temas; as cores vêm de cores.script,
// gerado pelo morfo-tema em cada pasta de tema.

Window.SetBackgroundTopColor(TOPO_R, TOPO_G, TOPO_B);
Window.SetBackgroundBottomColor(BASE_R, BASE_G, BASE_B);

logo.image = Image("logo-128.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

// Três pontos que "respiram" em sequência, abaixo da marca.
ponto_img = Image("ponto.png");
for (i = 0; i < 3; i++) {
    global.pontos[i] = Sprite(ponto_img);
    global.pontos[i].SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - 34 + i * 26,
        logo.y + logo.image.GetHeight() + 48,
        1);
    global.pontos[i].SetOpacity(0.25);
}

// Em funções do Plymouth as variáveis são locais: o estado usa "global.".
global.tempo = 0;
fun atualizar() {
    global.tempo = global.tempo + 1;
    for (i = 0; i < 3; i++) {
        fase = global.tempo / 12 - i * 0.7;
        global.pontos[i].SetOpacity(0.25 + 0.75 * Math.Clamp(Math.Sin(fase) * 0.5 + 0.5, 0, 1));
    }
}
Plymouth.SetRefreshFunction(atualizar);

// Mensagens do sistema (raras), centralizadas no rodapé.
global.msg = Sprite();
fun mensagem(texto) {
    img = Image.Text(texto, global.TEXTO_R, global.TEXTO_G, global.TEXTO_B);
    global.msg.SetImage(img);
    global.msg.SetOpacity(1);
    global.msg.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2,
        Window.GetY() + Window.GetHeight() - 60, 2);
}
Plymouth.SetMessageFunction(mensagem);

// Senha (só aparece se o disco for criptografado).
fun senha(prompt, bolinhas) {
    texto = prompt + "  ";
    for (i = 0; i < bolinhas; i++) texto = texto + "*";
    mensagem(texto);
}
Plymouth.SetDisplayPasswordFunction(senha);

fun normal() {
    global.msg.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal);
