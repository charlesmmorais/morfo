#!/bin/sh
# Morfo Linux — a sessão principal: o Claude Desktop em tela cheia.
# Chamada pelo greetd depois do login. Fechar o Claude volta para o login.
. /usr/local/lib/morfo-teclado.sh

# O Chromium/Electron só usa o gnome-keyring (para lembrar o seu login no
# Claude) quando acha que está num desktop GNOME.
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_DESKTOP=morfo
export XDG_SESSION_TYPE=wayland
# Wayland nativo quando o Electron suportar; senão o cage oferece Xwayland.
export ELECTRON_OZONE_PLATFORM_HINT=auto

if ! command -v claude-desktop >/dev/null 2>&1; then
    exec cage -s -- foot -e sh -c '
printf "\n  O Claude ainda não foi instalado.\n\n"
printf "  Ele é baixado do site oficial da Anthropic assim que houver internet:\n"
printf "  saia (exit), escolha \"Configurar Wi-Fi\" na tela de login e conecte.\n"
printf "  O Morfo termina sozinho e reinicia.\n\n"
printf "  Com internet, também dá para instalar agora:  sudo morfo-instalar-claude\n\n"
exec bash -l'
fi

# -d: sem decorações de janela; -s: permite trocar de terminal (Ctrl+Alt+F2).
exec cage -d -s -- claude-desktop
