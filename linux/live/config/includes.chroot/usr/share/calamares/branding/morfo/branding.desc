---
componentName: morfo

welcomeStyleCalamares: false
welcomeExpandingLogo: false
windowExpanding: fullscreen
windowSize: 1024px,680px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         Morfo Linux
    shortProductName:    Morfo
    version:             0.2
    shortVersion:        0.2
    versionedName:       Morfo Linux 0.2
    shortVersionedName:  Morfo 0.2
    bootloaderEntryName: Morfo
    productUrl:          https://github.com/charlesmmorais/morfo
    supportUrl:          https://github.com/charlesmmorais/morfo/issues
    knownIssuesUrl:      https://github.com/charlesmmorais/morfo/issues
    releaseNotesUrl:     https://github.com/charlesmmorais/morfo/releases

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

# Cores da barra lateral (Calamares 3.3 usa a primeira forma, versões
# anteriores a segunda).
style:
    SidebarBackground:        "#EFE6DA"
    SidebarText:              "#7D7066"
    SidebarTextCurrent:       "#2B2420"
    SidebarBackgroundCurrent: "#E2D6C6"
    sidebarBackground:        "#EFE6DA"
    sidebarText:              "#7D7066"
    sidebarTextSelect:        "#2B2420"
    sidebarSelect:            "#E2D6C6"

uploadServer:
    type: "none"
